<?php

namespace App\Http\Controllers;

use App\Models\Lamaran; // Pastikan Model ini ada (atau LamaranPkl sesuai file Anda)
use App\Models\Lowongan;
use App\Models\Pembimbing;
use App\Models\pembimbings;
use Illuminate\Http\Request;
use Illuminate\Support\Facades\Auth;
use Illuminate\Support\Facades\Storage;
use Carbon\Carbon;

class LamaranController extends Controller
{
    /**
     * Menampilkan formulir lamaran
     */
    public function create(Lowongan $lowongan)
    {
        // 1. Security Layer: Cek Status Lowongan
        if (!$lowongan->is_open) {
            return redirect()->route('guest.home')
                ->with('error', 'Mohon maaf, lowongan ini sudah ditutup.');
        }

        // 2. BEST PRACTICE: Cek Lamaran Aktif Global
        // Jika punya lamaran 'pending' atau 'diterima' di TEMPAT LAIN, tolak disini.
        if ($this->hasAnyActiveApplication()) {
            return redirect()->route('peserta.dashboard')
                ->with('error', 'Anda masih memiliki lamaran aktif. Tunggu verifikasi selesai atau status ditolak untuk melamar kembali.');
        }

        return view('peserta.lamaran.create', [
            'lowongan' => $lowongan,
            'title'    => 'Formulir Pendaftaran PKL',
            'header'   => 'Lamar Posisi: ' . $lowongan->judul
        ]);
    }

    /**
     * Memproses penyimpanan lamaran baru
     */
    public function store(Request $request, Lowongan $lowongan)
    {
        // 1. Cek Security Ulang (Double Check saat Submit)
        if (!$lowongan->is_open || $this->hasAnyActiveApplication()) {
            return redirect()->route('peserta.dashboard')
                ->with('error', 'Validasi gagal. Lowongan tutup atau Anda memiliki lamaran aktif.');
        }

        // 2. Validasi Input Form (Terpusat)
        $this->validateRequest($request, $lowongan);

        // 3. Validasi Bisnis: Cek Durasi Minimal
        if (!$this->isValidDuration($request, $lowongan)) {
            return back()->withErrors([
                'min_duration' => "Durasi magang kurang. Minimal {$lowongan->min_duration} bulan."
            ])->withInput();
        }
        // --- LOGIKA UPLOAD FILE BARU ---
        $pathSurat = null;
        if ($request->hasFile('file_surat_pengantar')) {
            $file = $request->file('file_surat_pengantar');
            // Simpan dengan nama unik
            $filename = 'surat_' . Auth::id() . '_' . time() . '.' . $file->getClientOriginalExtension();

            // Simpan ke folder storage/app/public/surat_pengantar
            $file->storeAs('public/surat_pengantar', $filename);

            $pathSurat = $filename; // Hanya simpan nama file di DB
        }

        //  Persiapkan Data (Logic Hari Kerja + Translate Indo)
        $finalData = $this->prepareData($request, $lowongan);
        // Masukkan path file ke array data
        $finalData['file_surat_pengantar'] = $pathSurat;
        // Simpan ke Database
        Lamaran::create($finalData);

        return redirect()->route('peserta.dashboard')
            ->with('success', 'Lamaran berhasil dikirim! Menunggu verifikasi admin.');
    }
    /**
     * METHOD 1: UPDATE STATUS (Untuk Lulus / Drop Out / Batal)
     * Dipanggil oleh tombol Wisuda (Lulus) dan tombol Ban (Drop Out)
     */
    // METHOD UPDATE STATUS (Dengan Logic Cut-off & Validasi)
    public function updateStatus(Request $request, $id)
    {
        $request->validate([
            // Status valid hanya sesuai skenario
            'status'  => 'required|in:pending,diterima,ditolak,selesai,berhenti',
            'catatan' => 'nullable|string|max:500',
        ]);

        $lamaran = Lamaran::findOrFail($id);

        // LOGIKA KHUSUS: BERHENTI (DROP OUT/RESIGN)
        if ($request->status == 'berhenti') {
            $lamaran->status = 'berhenti';
            $lamaran->tgl_selesai_resmi = now();

            // GABUNGKAN KATEGORI & DETAIL
            // Contoh hasil: "Mengundurkan Diri - Sakit Typus butuh istirahat"
            $kategori = $request->kategori ?? 'Berhenti';
            $detail   = $request->catatan_detail ?? '-';

            $lamaran->catatan_admin = "$kategori - $detail";
        }
        // LOGIKA KHUSUS: SELESAI (LULUS)
        elseif ($request->status == 'selesai') {
            $lamaran->status = 'selesai';
            // Tanggal selesai tetap sesuai jadwal, atau bisa di-set now() jika lulus lebih awal
        }
        // LOGIKA LAIN (Pending/Ditolak/Diterima)
        else {
            $lamaran->status = $request->status;
            if ($request->filled('catatan')) {
                $lamaran->catatan_admin = $request->catatan;
            }
        }

        $lamaran->save();

        // Pesan Feedback
        $msg = 'Status berhasil diperbarui.';
        if ($request->status == 'berhenti') $msg = 'Peserta diberhentikan. Akses absensi ditutup per hari ini.';
        if ($request->status == 'selesai') $msg = 'Selamat! Peserta berhasil diluluskan menjadi Alumni.';

        return back()->with('success', $msg);
    }

    // METHOD BARU: MENAMPILKAN DATA ALUMNI
    public function indexAlumni(Request $request)
    {
        $search = $request->keyword;

        // Ambil data yang statusnya SELESAI atau BERHENTI
        $alumni = Lamaran::with(['pengguna', 'lowongan'])
            ->whereIn('status', ['selesai', 'berhenti'])
            ->when($search, function ($query, $search) {
                return $query->whereHas('pengguna', function ($q) use ($search) {
                    $q->where('name', 'like', "%{$search}%");
                });
            })
            ->latest('updated_at') // Urutkan berdasarkan kapan mereka keluar
            ->paginate(15)
            ->withQueryString();

        return view('admin.alumni.index', [
            'alumni' => $alumni,
            'title'  => 'Data Alumni & Arsip'
        ]);
    }
    /**
     * METHOD 2: APPROVE / EDIT DATA (Untuk Tombol Pulpen & Ceklis)
     * Menangani penyimpanan Tanggal Resmi, Hari Kerja, dan Pembimbing
     */
    public function approve(Request $request, Lamaran $lamaran)
    {
        // Pastikan User punya hak akses (Admin)
        // if (!auth()->user()->isAdmin()) abort(403); 

        // 1. Validasi sesuai kolom database
        $validated = $request->validate([
            'pembimbing_id'     => 'required|exists:pembimbings,id',
            'tgl_mulai_resmi'   => 'required|date',
            'tgl_selesai_resmi' => 'required|date|after_or_equal:tgl_mulai_resmi',
            'hari_kerja_resmi'  => 'required|array', // Wajib array karena dicasting JSON
        ]);

        // 2. Update Database
        $lamaran->update([
            'status'            => 'diterima', // Paksa jadi diterima
            'pembimbing_id'     => $validated['pembimbing_id'],
            'tgl_mulai_resmi'   => $validated['tgl_mulai_resmi'],
            'tgl_selesai_resmi' => $validated['tgl_selesai_resmi'],
            'hari_kerja_resmi'  => $validated['hari_kerja_resmi'], // Laravel otomatis jadikan JSON
        ]);

        return back()->with('success', 'Data magang resmi berhasil disimpan.');
    }
    /**
     * Menangani penolakan lamaran oleh Admin.
     */

    public function reject(Request $request, Lamaran $lamaran)
    {
        // ... (Cek keamanan & validasi input) ...

        $lamaran->update([
            'status' => 'ditolak',
            'catatan_admin' => $request->catatan_admin,
        ]);

        // --- PERBAIKAN REDIRECT DISINI ---
        // Redirect langsung ke halaman index verifikasi dengan filter status 'ditolak'
        return redirect()->route('lamaran.index.admin', ['status' => 'ditolak'])
            ->with('success', 'Lamaran berhasil ditolak dan status diperbarui.');
    }

    public function indexAdmin(Request $request)
    {
        // 1. Ambil Input
        $status = $request->input('status', 'pending');
        $search = $request->input('keyword');
        $lowonganId = $request->input('lowongan_id');

        // 2. Query Data Lamaran
        $lamarans = Lamaran::with(['pengguna.profile', 'lowongan']) // Eager load profile biar gambar muncul
            // Filter Status
            ->when($status !== 'all', function ($query) use ($status) {
                return $query->where('status', $status);
            })
            // Filter Lowongan
            ->when($lowonganId, function ($query) use ($lowonganId) {
                return $query->where('lowongan_id', $lowonganId);
            })
            // Filter Search (Advanced)
            ->when($search, function ($query, $search) {
                return $query->where(function ($q) use ($search) {
                    $q->whereHas('pengguna', function ($subQ) use ($search) {
                        $subQ->where('name', 'like', "%{$search}%");
                    })->orWhereHas('lowongan', function ($subQ) use ($search) {
                        $subQ->where('judul', 'like', "%{$search}%")
                            ->orWhere('divisi', 'like', "%{$search}%");
                    });
                });
            })
            ->latest()
            ->paginate(15)
            ->withQueryString();

        // 3. Ambil Data Pendukung (Untuk Dropdown Filter & Modal)
        // Kita kirim dari sini biar View bersih dari query Logic
        $mentors = Pembimbing::where('is_active', true)->orderBy('nama')->get(['id', 'nama']);
        $lowongans = \App\Models\Lowongan::orderBy('judul')->get(['id', 'judul']);

        return view('admin.lamaran.index', [
            'lamarans'      => $lamarans,
            'mentors'       => $mentors,
            'lowongans'     => $lowongans, // <--- Kirim ini ke view
            'currentStatus' => $status,
            'title'         => 'Verifikasi Lamaran',
            'header'        => 'Daftar Lamaran Masuk'
        ]);
    }


